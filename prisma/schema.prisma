// See docs/SPEC.md §6 for the field-level rationale and docs/architecture.md
// for why SQLite (Postgres-portable schema, no SQLite-only types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Competency {
  id                    Int        @id @default(autoincrement())
  number                Int        @unique
  title                 String
  subtitle              String
  tagline               String     @default("") // real booklet callout line under the title, empty until authored (docs/features/0008-booklet-learn-refresh.md)
  shiftMarkdown         String
  masteryBullets        String // JSON-encoded string[]
  commonMistakeMarkdown String
  toolkitTags           String // JSON-encoded string[]
  inPracticeBullets     String     @default("[]") // JSON-encoded string[] — empty until authored for a competency (docs/features/0008-booklet-learn-refresh.md)
  quoteMarkdown         String     @default("") // real booklet pull-quote, empty until a competency's page has one
  quoteAttribution      String     @default("") // e.g. "Ben SE, CTO, CodeWalnut" — empty alongside quoteMarkdown
  exercises             Exercise[]
}

model Exercise {
  id                Int                    @id @default(autoincrement())
  competencyId      Int
  competency        Competency             @relation(fields: [competencyId], references: [id])
  number            Int
  slug              String                 @unique
  title             String
  missionMarkdown   String
  durationLabel     String
  howToSteps        String // JSON-encoded string[]
  evidenceChecklist String // JSON-encoded {label: string}[]
  completionCriteria String // JSON-encoded string[]
  projects          ExerciseProject[]
  guidanceDocs      ExerciseGuidanceDoc[]
  submissions       Submission[]

  @@unique([competencyId, number])
}

model ExerciseProject {
  id          Int      @id @default(autoincrement())
  exerciseId  Int
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  repoPath    String
  displayName String
  isPrimary   Boolean  @default(false)
}

// Real, already-written guidance docs pulled verbatim from each exercise's
// own docs/ folder (evidence-template.md, *-contract.md, a real AGENTS.md
// or SKILL.md example, ...) — not authored by the portal. See
// scripts/generate-seed.mjs's readGuidanceDocs for the source and
// docs/adr/ for why we surface real repo content instead of writing our
// own generic templates.
model ExerciseGuidanceDoc {
  id         Int      @id @default(autoincrement())
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  filename   String // relative to the exercise's docs/ folder for most docs (e.g. "context-sources/AGENTS.md"), or relative to the exercise root for real SKILL.md files found elsewhere in its tree (e.g. ".agents/skills/release-notes/SKILL.md")
  title      String
  content    String
  sortOrder  Int
}

// Every user belongs to exactly one company — see docs/adr/
// 0004-multi-tenant-companies.md and docs/features/0015-companies-roles.md.
// company_admin is added to the enum now so a later decision on its
// actual capabilities doesn't need a second migration; nothing branches
// on it yet.
model Company {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  logoUrl     String? // shown on the company-branded login page
                       // (/login/:slug) and in the embed snippet's
                       // preview — docs/features/0016-embed-widget.md
  accentColor String? // hex, e.g. "#3fb950" — same page, optional
  createdAt   DateTime @default(now())
  users       User[]
}

// See docs/features/0018-role-separation.md for the full capability
// matrix. facilitator and company_admin are a clean split (reviews vs.
// company management — neither does the other's job); super_admin has
// full control across every company, not just its own.
enum Role {
  learner
  facilitator
  company_admin
  super_admin
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(learner) // the primary role — default landing page, Users table's headline role
  extraRoles   UserRole[] // additional roles this account also holds, e.g. a company_admin who is also a facilitator — docs/features/0019-multi-role.md
  companyId    Int
  company      Company      @relation(fields: [companyId], references: [id])
  submissions  Submission[] @relation("SubmissionsByUser")
  decisions    Submission[] @relation("DecisionsByFacilitator")
}

// A user's *effective* role set is [role, ...extraRoles] deduped — see
// lib/current-user.ts. Kept as its own table (not a JSON array on User)
// so "does this account have role X" stays a real, indexable query
// instead of string matching inside a JSON blob.
model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])
  role   Role

  @@unique([userId, role])
}

enum SubmissionStatus {
  not_started
  in_progress
  submitted
  needs_rework
  passed
}

model Submission {
  id                 Int                @id @default(autoincrement())
  userId             Int
  user               User               @relation("SubmissionsByUser", fields: [userId], references: [id])
  exerciseId         Int
  exercise           Exercise           @relation(fields: [exerciseId], references: [id])
  status             SubmissionStatus   @default(not_started)
  startedAt          DateTime?
  submittedAt        DateTime?
  decidedAt          DateTime?
  decidedById        Int?
  decidedBy          User?              @relation("DecisionsByFacilitator", fields: [decidedById], references: [id])
  facilitatorComment String?
  prLink             String?
  learnerNote        String?
  evidenceArtifacts  EvidenceArtifact[]

  @@unique([userId, exerciseId])
}

enum EvidenceKind {
  link
  note
}

model EvidenceArtifact {
  id              Int          @id @default(autoincrement())
  submissionId    Int
  submission      Submission   @relation(fields: [submissionId], references: [id])
  checklistLabel  String
  kind            EvidenceKind
  url             String
  note            String?
  createdAt       DateTime     @default(now())
}
